# Fresh Lite deployment. Keep this enabled when Classic settings should not be inherited.
LITE_DISABLE_LEGACY_CONFIG=1

# Use /lite to keep Classic available, or / to make Lite the root application.
LITE_APP_PATH=/lite
LITE_BASE_URL=
LITE_TIMEZONE=Asia/Shanghai

LITE_MAX_FILE_SIZE=10485760
LITE_MAX_FILES=10
# Standalone Lite deployments enable the managed-token API by default in this example.
# The application default remains disabled when LITE_API_ENABLED is unset.
LITE_API_ENABLED=1

# Only enable proxy trust with an explicit reverse-proxy IP allowlist.
LITE_TRUSTED_PROXY=0
LITE_TRUSTED_PROXY_IPS=
LITE_CLIENT_IP_HEADER=HTTP_X_REAL_IP
